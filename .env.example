# Resale Platform — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Reference: docs/SETUP_CHECKLIST.md §3

# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Stripe (test/sandbox keys only until launch)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PostHog (B4)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry (B8)
SENTRY_DSN=

# ── Feature flags (default off; see docs/LAUNCH_ROADMAP.md) ──────────────────
VERIFICATION_ENABLED=false
RECS_ENABLED=false
BUMP_ENABLED=false
SAVED_SEARCH_ALERTS_ENABLED=false
NOTIFICATIONS_ENABLED=false
AUTH_BADGE_ENABLED=false
SHIPPING_LABELS_ENABLED=false
FOLLOWS_ENABLED=false
REVIEWS_ENABLED=false

# ── recs-engine (only used when RECS_ENABLED=true) ───────────────────────────
# Secrets are SERVER-SIDE ONLY — never expose the HMAC secret or feed token to
# the browser. Telemetry is posted to a Next route handler that signs server-side.
RECS_INGEST_URL=http://localhost:8000
RECS_FEED_URL=http://localhost:8001
RECS_FEED_API_TOKEN=
RECS_INGEST_HMAC_SECRET=

# ── Notifications (only used when NOTIFICATIONS_ENABLED=true) ─────────────────
# Transactional email + push provider keys (server-side only).
EMAIL_PROVIDER_API_KEY=
PUSH_PROVIDER_API_KEY=

# ── Shipping (only used when SHIPPING_LABELS_ENABLED=true) ────────────────────
SHIPPING_PROVIDER_API_KEY=

# ── ID verification provider (only used when VERIFICATION_ENABLED=true) ───────
IDV_PROVIDER_API_KEY=
IDV_PROVIDER_WEBHOOK_SECRET=
