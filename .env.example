# Resale Platform — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Reference: docs/SETUP_CHECKLIST.md §3

# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Stripe (test/sandbox keys only until launch)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# TWO webhook endpoints post to /api/webhooks/stripe, each with its own signing secret:
#   STRIPE_WEBHOOK_SECRET          "Events on your account": payment_intent.succeeded,
#                                  payment_intent.payment_failed, charge.refunded, identity.*
#   STRIPE_CONNECT_WEBHOOK_SECRET  "Events on Connected accounts": account.updated (this is
#                                  what flips sellers' payouts_enabled; without it no listing
#                                  can be approved and no checkout can succeed in production).
# `stripe listen` forwards both kinds with ONE secret, which is why local dev never needed
# the second value; set it in Vercel. See docs/LAUNCH_RUNBOOK.md Phase 4.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# PostHog (B4)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry (B8)
SENTRY_DSN=

# ── Feature flags (default off; see docs/LAUNCH_ROADMAP.md) ──────────────────
VERIFICATION_ENABLED=false
RECS_ENABLED=false
NEXT_PUBLIC_RECS_ENABLED=false   # client telemetry gate; keep in step with RECS_ENABLED
BUYER_REWARDS_ENABLED=false            # Fee v3: buyer milestone reward coupons
NEXT_PUBLIC_BOOSTED_POSTS_ENABLED=false  # Fee v3: paid boosted/promoted listings
BUMP_ENABLED=false
SAVED_SEARCH_ALERTS_ENABLED=false
NOTIFICATIONS_ENABLED=false
AUTH_BADGE_ENABLED=false
SHIPPING_LABELS_ENABLED=false
FOLLOWS_ENABLED=false
REVIEWS_ENABLED=false
VISUAL_SEARCH_ENABLED=false             # search by photo (needs the recs VPS: RECS_FEED_URL + RECS_FEED_API_TOKEN)
NEXT_PUBLIC_VISUAL_SEARCH_ENABLED=false # camera control in the UI; keep in step with VISUAL_SEARCH_ENABLED
VISUAL_SEARCH_GUESTS=true               # guests may search by photo (rate-limited by IP); false = sign-in required

# ── recs-engine (only used when RECS_ENABLED=true) ───────────────────────────
# Secrets are SERVER-SIDE ONLY — never expose the HMAC secret or feed token to
# the browser. Telemetry is posted to a Next route handler that signs server-side.
# Local dev points at docker-compose (:8000 ingest, :8001 feed). In production the
# engine runs on Cloud Run as two services — set these to the two *.run.app URLs.
# Deploy runbook: recs-engine/ops/cloudrun/README.md. The HMAC secret + feed token
# below MUST match the engine's Secret Manager values (recs-ingest-hmac, recs-feed-token).
RECS_INGEST_URL=http://localhost:8000    # prod: https://recs-api-XXXX.run.app
RECS_FEED_URL=http://localhost:8001      # prod: https://recs-feed-XXXX.run.app
RECS_FEED_API_TOKEN=
RECS_INGEST_HMAC_SECRET=

# ── Notifications (only used when NOTIFICATIONS_ENABLED=true) ─────────────────
# Transactional email + push provider keys (server-side only).
EMAIL_PROVIDER_API_KEY=
PUSH_PROVIDER_API_KEY=

# ── Shipping (only used when SHIPPING_LABELS_ENABLED=true) ────────────────────
SHIPPING_PROVIDER_API_KEY=

# ── ID verification provider (only used when VERIFICATION_ENABLED=true) ───────
IDV_PROVIDER_API_KEY=
IDV_PROVIDER_WEBHOOK_SECRET=

# ── Social auth toggles ──────────────────────────────────────────────────────
# NEXT_PUBLIC_* → inlined at BUILD time (set in Vercel for prod; restart dev after
# changing locally). The button only RENDERS when 'true', and only WORKS once the
# matching provider is enabled in Supabase → Auth → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false
# ── SEO indexing gate ────────────────────────────────────────────────────────
# false (or unset) during the vercel.app trusted-tester window: pages emit
# noindex while robots.txt still allows crawling; the sitemap reference is
# withheld. Set true ONLY at real-domain cutover (LAUNCH_RUNBOOK "when the
# real domain arrives" — update NEXT_PUBLIC_APP_URL there first).
SEO_INDEXING_ENABLED=false

# ── Native apps (archive-ios / archive-android) ──────────────────────────────
# Absolute origin of this deployment — used for Stripe/Identity return URLs and notification links.
# Build-time. Unset falls back to http://localhost:3000, which Stripe live mode rejects.
NEXT_PUBLIC_APP_URL=
# APNs token auth (Apple Developer → Keys → APNs). APNS_PRIVATE_KEY = the .p8 file contents
# (literal "\n" sequences accepted). APNS_ENV = sandbox | production.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=supply.archive.ios
APNS_ENV=
# Force-upgrade floor returned by GET /api/mobile/config (integer build numbers; default 1).
MOBILE_MIN_BUILD_IOS=
MOBILE_MIN_BUILD_ANDROID=

# ── Referenced in code, previously undocumented ───────────────────────────────
CRON_SECRET=
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
EASYPOST_WEBHOOK_SECRET=
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
